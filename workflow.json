        "message": "=Summary: {{ $json.summary }}\n\nFrom: {{ $json.name }} <{{ $json.email }}>\n\nOriginal message:\n{{ $json.message }}\n\nSuggested reply:\n{{ $json.suggested_reply }}",
        "options": {}
